{
  "expo": {
    "name": "Bugün Ne Oynasam",
    "slug": "GameFinderApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gamefinder-logo.jpg",
    "scheme": "gamefinderapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gamefinder-logo.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gamefinder-logo.jpg",
        "backgroundColor": "#04243B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.exclurastudio.gamefinder"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/gamefinder-logo.jpg"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030814",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "./scripts/with-android-kotlin.cjs",
      "./scripts/with-android-build-memory.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#030814"
  }
}
